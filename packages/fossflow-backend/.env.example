#### Authentication (Optional)
 AUTH_ENABLED=false
 JWT_SECRET=your-secret
 JWT_EXPIRES_IN=1h
 AUTH_COOKIE_NAME=fossflow_auth
 AUTH_COOKIE_SECURE=false
 AUTH_CORS_ORIGIN=http://locahost:3000

#### AI Assistant  LiteLLM Configuration
 ENABLE_AI_ASSISTANT=true
 LITELLM_BASE_URL=your-url
 LITELLM_API_KEY=your-code
 LITELLM_TIMEOUT_MS=60000
 AI_ASSISTANT_MODEL=your-model

#### AI Assistant  LightRAG Configuration (Knowledge Assistant)
 LIGHTRAG_BASE_URL=your url
 LIGHTRAG_QUERY_STREAM_PATH=/query/stream
 LIGHTRAG_API_KEY=your-password
 LIGHTRAG_API_KEY_HEADER=header-code
 LIGHTRAG_API_KEY_PREFIX=
 LIGHTRAG_TIMEOUT_MS=90000